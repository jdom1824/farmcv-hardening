# Copy to .env and replace every example value before running the application.
APP_NAME=FarmCV API
ENVIRONMENT=hardhat
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
PUBLIC_BASE_URL=http://127.0.0.1:8010
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-pbkdf2-hmac-sha256-hash
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BLOCKCHAIN_PRIVATE_KEY=
TRUSTED_PROXY_CIDRS=
JWT_EXPIRE_MINUTES=15
RPC_TIMEOUT_SECONDS=5
CONFIRMATIONS_REQUIRED=1
CONTRACT_DEPLOYMENT_BLOCK=0
CV_ENCRYPTION_KEY_FILE=.secrets/cv-fernet.key
TRANSACTION_DB_FILE=storage/transactions/operations.sqlite3
TRANSACTION_POLL_SECONDS=2
